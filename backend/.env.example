# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=your_supabase_postgres_connection_string_here

# JWT Configuration for Merchant Auth
JWT_SECRET=your_jwt_signing_secret_here

# AI Services
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here

# Razorpay Test Mode Keys (Do not check secrets into GitHub!)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
